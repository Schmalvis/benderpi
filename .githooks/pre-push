#!/usr/bin/env bash
# Pre-push gate: catch a broken test suite before it ships.
#
# BenderPi auto-deploys from `main` within ~5 minutes of a push (git-pull
# timer on the device). There is no CI runner, so this hook is the only
# thing standing between a broken import and a live restart of
# bender-converse. Keep it FAST (<10s) — if it gets slow, it gets bypassed
# with --no-verify and stops protecting anything.
#
# What it runs:
#   1. `pytest --collect-only` across the whole suite — this alone catches
#      the class of break that shipped silently before (test modules
#      importing names that no longer exist, e.g. the ha_control ->
#      entity_matcher API split). Collection is cheap even with ~500+ tests.
#   2. The FULL test suite (~18s on a Pi 5 dev box).
#
#      This used to be a curated 6-module subset, because the full suite had
#      ~63 standing failures and gating on them would have made the hook
#      permanently red and guaranteed it got skipped. Those failures were
#      swept on 2026-07-30 — they were almost all stale assertions left by
#      refactors (web-routes attribute moves, the vlm.py YOLO->VLM swap, the
#      streaming method-label change), not hardware absence: 53 of them
#      failed on the device too.
#
#      Keeping a red wall was not free. It hid two real defects:
#      test_config_loads_defaults masked a whisper default raised tiny.en ->
#      base.en (a 27s median CPU STT path), and test_watchdog's hardcoded
#      2026-03-29 timestamps aged out of the 168h lookback in April, leaving
#      every watchdog alerting check untested for four months. A green suite
#      is the only version of this hook that protects anything.
#
#      If this ever goes red for reasons unrelated to your change, FIX THE
#      TEST — do not re-introduce a subset.
#
# Install: `git config core.hooksPath .githooks` (see README/CLAUDE.md).

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

PY=venv/bin/python
if [ ! -x "$PY" ]; then
    PY=python3
fi

echo "[pre-push] collecting full test suite (import/collection check)..."
if ! "$PY" -m pytest --collect-only -q; then
    echo "[pre-push] FAILED: test collection is broken (an import failed)." >&2
    echo "[pre-push] This would ship to the live device via auto-deploy. Fix before pushing." >&2
    exit 1
fi

echo "[pre-push] running full test suite..."
if ! "$PY" -m pytest -q; then
    echo "[pre-push] FAILED: the test suite is red." >&2
    echo "[pre-push] This would ship to the live device via auto-deploy." >&2
    echo "[pre-push] Fix the test — do not bypass with --no-verify." >&2
    exit 1
fi

echo "[pre-push] OK."
